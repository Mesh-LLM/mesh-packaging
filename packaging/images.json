      "platforms": ["linux/amd64"]
    },
    {
      "id": "alpine-cpu",
      "distro": "alpine",
      "distro_version": "3.21",
      "backend": "cpu",
      "backend_version": "",
      "upstream_flavor": "cpu",
      "support_level": "blocked_upstream",
      "release_track": "downstream_extension",
      "release_enabled": false,
      "matrix_enabled": false,
      "package_base_image": "alpine:3.21",
